# ============================================================
# IQCommune — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------

# Canonical public URL — no trailing slash
# Dev:  http://localhost:3000
# Prod: https://iqcommune.in
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/<id>/settings/api
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Never expose this in the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Storage bucket for session photos (matches your Supabase storage bucket name)
SUPABASE_PHOTOS_BUCKET=session-photos

# ------------------------------------------------------------
# Security — generate with: openssl rand -hex 32
# ------------------------------------------------------------

# HMAC request signing — minimum 32 characters
HMAC_SECRET=

# AES-256 field encryption — must be exactly 64 hex characters (32 bytes)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# Cron job authorization header — minimum 16 characters
# Generate: openssl rand -base64 24
CRON_SECRET=

# ------------------------------------------------------------
# Rate limiting — Upstash Redis
# https://console.upstash.com → your database → REST API
# ------------------------------------------------------------

UPSTASH_REDIS_REST_URL=https://<database-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<rest-token>

# ------------------------------------------------------------
# Email — Brevo (formerly Sendinblue)
# https://app.brevo.com/settings/keys/api
# ------------------------------------------------------------

BREVO_API_KEY=xkeysib-<your-key>
# Delivery mode. "live" actually sends through Brevo; ANY other value (or
# unset) logs the message and sends nothing.
# REQUIRED IN PRODUCTION — leaving it unset is the usual cause of "the app
# works but no mail arrives". Left commented here so that copying this file
# to .env.local cannot start mailing real practitioners from a dev machine.
# EMAIL_DELIVERY=live
BREVO_SENDER_EMAIL=noreply@iqcommune.in
# Optional — defaults to "iqcommune" if not set
BREVO_SENDER_NAME=IQCommune
# Optional — inbox that receives internal alerts (new application / new session
# request). Falls back to BREVO_SENDER_EMAIL when unset.
ADMIN_NOTIFY_EMAIL=hello@iqcommune.com

# --- Addresses the SITE DISPLAYS (never sent from) ---
# Neither is a Brevo sender, so neither needs sender verification and both
# may be any mailbox you actually read. Changing either is an env change and a
# redeploy — never a code change. A redeploy and not merely a restart because
# /, /login and /practitioners are statically prerendered, so the footer address
# is resolved at build time; the six emailed link pages are per-request.

# The inbox printed in the footer of every page, and in the closing
# 'questions?' line under each emailed link page.
# Unset falls back to hello@iqcommune.com.
CONTACT_EMAIL=hello@iqcommune.com

# Recipient of the request form's mailto fallback, offered to a visitor when
# their session request cannot be saved. Deliberately NOT
# BREVO_SENDER_SESSION: that one is a verified From:, and repointing it to
# change where visitors write would break every outbound session email.
# Unset falls back to the session sender.
SESSION_CONTACT_EMAIL=session@iqcommune.com

# Recipient of the application form's mailto fallback, offered to a would-be
# practitioner when their application cannot be saved. The application and the
# session request are answered by different people, which is why this is not
# the same variable as the one above.
# Unset falls back to the practitioner sender.
PRACTITIONER_CONTACT_EMAIL=practitioner@iqcommune.com

# Per-stream From addresses (client decision, 2026-07-23).
#   practitioner pipeline  -> practitioner@iqcommune.com
#   session pipeline       -> session@iqcommune.com
# Which mailbox an email uses is declared on the TEMPLATE, not at the call site,
# so these two values ARE the routing. No address is hardcoded anywhere in the
# code, now or later:
#   to change either address    -> edit the value here (local: restart the dev
#                                  server; Vercel: update the env var and
#                                  redeploy — a running deploy keeps the old one)
#   to add a third mailbox      -> add the var + one line in SENDER_ENV
#                                  (lib/email/send.ts) and tag the templates
#   to send everything from one -> comment both out; all mail falls back to
#                                  BREVO_SENDER_EMAIL
# BOTH ARE OPTIONAL AND FALL BACK TO BREVO_SENDER_EMAIL. Leave them unset until
# the Google Workspace mailboxes exist AND are verified as senders in Brevo:
# Brevo rejects a send from an unverified address outright, so setting these
# early breaks mail that currently works.
BREVO_SENDER_PRACTITIONER=practitioner@iqcommune.com
BREVO_SENDER_SESSION=session@iqcommune.com
# Shared secret guarding the Brevo delivery webhook (POST /api/webhooks/brevo?token=…).
# REQUIRED for delivery/bounce tracking — the endpoint returns 503 until this is set.
# Configure the same value in Brevo → Transactional → Settings → Webhook URL.
BREVO_WEBHOOK_SECRET=<random-long-string>

# ------------------------------------------------------------
# Admin (optional — dev / bootstrap convenience)
# In production, grant admin via Supabase Auth app_metadata:
#   { "role": "admin" }
# Only set ADMIN_EMAIL here for local dev or initial seeding.
# ------------------------------------------------------------

ADMIN_EMAIL=
# ADMIN_PASSWORD is used by e2e tests only (never in app code)
ADMIN_PASSWORD=

# ------------------------------------------------------------
# Global Admin (optional — bootstrap only)
# In production, grant global-admin via Supabase Auth app_metadata:
#   { "role": "global_admin" }   ← preferred; then leave this UNSET.
# GLOBAL_ADMIN_EMAIL is a fallback that grants /console/global access to this
# email even without the role — use only for local dev / first-run bootstrap.
# (The legacy SUPER_ADMIN_EMAIL var is still read as a fallback for continuity.)
# ------------------------------------------------------------

GLOBAL_ADMIN_EMAIL=

# ------------------------------------------------------------
# Testing (e2e only — do not set in production)
# ------------------------------------------------------------

# Serialised Supabase auth cookies for admin e2e tests.
# Generate by logging in manually and copying document.cookie.
# SUPABASE_TEST_SESSION=
