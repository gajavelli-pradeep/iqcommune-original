# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Not `/node_modules` — this is a pnpm workspace, so nested package dirs get
# their own, and an anchored rule leaves those tracked.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# secrets — this repo is pushed to a public remote
#
# `.env*` catches .env, .env.local, .env.production, .env.staging and anything
# else added later.
#
# .env.example is negated back in, having been read line by line and confirmed
# value-free (2026-07-23): every credential is a `<placeholder>`, and the only
# concrete values are localhost, a bucket name and public @iqcommune addresses.
# It has to be tracked — an untracked template is a template nobody receives,
# which is how BREVO_SENDER_PRACTITIONER/_SESSION and EMAIL_DELIVERY came to be
# read by the code while appearing in no file an operator could see.
# tests/unit/env-contract.test.ts fails if a variable the code reads is missing
# from it. Anything with a REAL value belongs in .env.local, which stays ignored.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
service-account*.json
secrets.*
*.secret

# vercel / supabase local state
.vercel
supabase/.branches/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP verification artifacts
.playwright-mcp/

# Playwright
test-results/
playwright-report/
blob-report/
.cache/

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# visual-parity scratch (not shipped)
_parity/
_shot.mjs

# dev-only console preview (not shipped)
app/console-preview/
.claude/
package-lock.json

# meeting notes — kept locally for traceability, never committed
docs/MOM-*.md
